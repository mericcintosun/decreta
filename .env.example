# Copy to .env.local. Every variable is optional: with none set, the app runs on
# the seed register and simulated transactions.

# Data source for pages and API routes (lib/adapter.ts). `fake` (default) uses the
# seed register and never calls the network. `real` reads CourtListener once
# COURTLISTENER_API_TOKEN is set, and DecretaEscrow on Sepolia once
# NEXT_PUBLIC_CONTRACT_ADDRESS is set.
ADAPTER_MODE=fake

# CourtListener REST API v4 token (server only, read by lib/secrets.ts).
# Free: create an account at https://www.courtlistener.com/sign-in/ then copy the
# token from https://www.courtlistener.com/profile/api/
COURTLISTENER_API_TOKEN=

# DecretaEscrow address on Sepolia, printed by contracts/script/Deploy.s.sol
# (read by lib/config.ts). Leave empty to keep the mock lock path and seed reads.
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Chain id the frontend targets (lib/config.ts). Ethereum Sepolia is 11155111.
NEXT_PUBLIC_CHAIN_ID=11155111

# Alchemy or Infura Sepolia endpoint, server only (lib/secrets.ts). Empty uses
# viem's public Sepolia RPC, which rate limits event scans.
SEPOLIA_RPC_URL=

# Block number of the Deploy.s.sol tx on sepolia.etherscan.io (lib/secrets.ts).
# Event timelines start here; unset, the record shows state without tx links.
ESCROW_DEPLOY_BLOCK=

# ---- Contracts only (forge scripts, never read by the Next.js app) ----

# Deployer private key of a TESTNET wallet. Fund it at https://faucets.chain.link/sepolia
PRIVATE_KEY=

# Sepolia RPC endpoint, for example from Alchemy, Infura or https://chainlist.org/chain/11155111
RPC_URL=

# Optional: the Chainlink CRE forwarder allowed to call onReport. Defaults to the
# Sepolia MockKeystoneForwarder used by `cre workflow simulate --broadcast`
# (see https://docs.chain.link/cre for the current address).
CRE_FORWARDER=

# Address of the deployed DecretaEscrow, read by contracts/script/Smoke.s.sol.
DEPLOYED_CONTRACT=
